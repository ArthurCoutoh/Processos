@page "/processos"
@rendermode InteractiveServer
@inject ProcessoDAO dao
<PageTitle>Processos - Sistema de Controle de Processos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2">Consulta de Processos</h1>
    <a class="btn btn-primary" href="/processos/cadastro"><i class="bi bi-plus-lg"></i> Novo Processo</a>
</div>

@if (!string.IsNullOrEmpty(erro))
{
    <div class="alert alert-danger">@erro</div>
}
else if (processos.Count == 0)
{
    <div class="alert alert-info">Nenhum processo cadastrado.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Número</th>
                        <th>Interessado</th>
                        <th>Assunto</th>
                        <th>Situação</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in processos)
                    {
                        <tr>
                            <td>@p.Id</td>
                            <td>@p.Numero</td>
                            <td>@p.Interessado</td>
                            <td>@p.Assunto</td>
                            <td>@p.Situacao</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a href="@($"/processos/editar/{p.Id}")" class="btn btn-light border text-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-light border text-danger" title="Exclusão ainda não implementada" disabled>
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<Processo> processos = new();
    private string? erro;

    protected override void OnInitialized()
    {
        try
        {
            processos = dao.Listar();
        }
        catch (Exception)
        {
            erro = "Não foi possível carregar os processos. Confira a conexão com o MySQL.";
        }
    }
}
